{
  "name": "ls-wp-build-plugin",
  "version": "1.0.0",
  "description": "Claude skill that generates WordPress block plugins from LightSpeed's block-plugin-scaffold through its local MCP server. It collects the plugin details (post types, taxonomies, custom fields), validates them and previews every file. Nothing is written until you approve.",
  "main": "SKILL.md",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose --coverage",
    "test:all": "npm run test",
    "lint:js": "eslint .",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules",
    "lint:all": "npm run lint:js && npm run lint:md && npm run format:check",
    "format:check": "prettier --check ."
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.{js,cjs,mjs}",
      "!**/node_modules/**",
      "!**/__tests__/**",
      "!coverage/**",
      "!*.config.{js,cjs,mjs}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true
  },
  "keywords": [
    "wordpress",
    "claude",
    "skill",
    "block-plugin",
    "mcp"
  ],
  "author": "LightSpeed",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightspeedwp/ls-wp-build-plugin.git"
  },
  "private": true
}
